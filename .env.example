# Server
PORT=3000
NODE_ENV=development

# Minutes between ping cycles across all registered URLs
PING_INTERVAL_MIN=5

# Timeout per request (ms)
PING_TIMEOUT_MS=10000

# Maximum number of URLs allowed
MAX_URLS=50

# Ping this service itself on every cycle (self-awake) — set your public URL
SELF_PING_URL=

# Comma-separated seed URLs loaded at boot (reloaded even if the data file is lost)
URLS=

# Data directory (default: ./data). Point to your mount path when using a cloud volume.
DATA_DIR=

# --- Access control (dashboard login) ---
AUTH_USER=admin
AUTH_PASS=change-me
# Session lifetime in days
AUTH_SESSION_DAYS=7
# Optional: fixed secret for session cookie signing (auto-generated if empty)
AUTH_SECRET=
