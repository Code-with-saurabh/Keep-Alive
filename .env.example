# Server
PORT=3000
NODE_ENV=development

# Kitne minute me saare URLs pe ping jayega
PING_INTERVAL_MIN=5

# Har request ka timeout (ms)
PING_TIMEOUT_MS=10000

# Max kitne URLs add ho sakte hain
MAX_URLS=50

# Ye service khud ko ping kare (self-awake) — apna public URL yahan daalo
SELF_PING_URL=

# Comma-separated seed URLs (file delete hone pe bhi yahi se load honge)
URLS=

# Data kahan save ho (default: ./data). Cloud volume laga ho to wahi path.
DATA_DIR=
